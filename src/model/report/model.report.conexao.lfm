  object qryPadrao: TSQLQuery
    MaxIndexesCount = 4
    FieldDefs = <    
      item
        Name = 'TOTAL_DESPESA'
        DataType = ftBCD
        Precision = 18
        Size = 2
      end    
      item
        Name = 'TOTAL_RECEBIMENTO'
        DataType = ftBCD
        Precision = 18
        Size = 2
      end    
      item
        Name = 'TOTAL_SALDO'
        DataType = ftBCD
        Precision = 18
        Size = 2
      end    
      item
        Name = 'MES'
        DataType = ftSmallint
        Precision = -1
      end    
      item
        Name = 'ANO'
        DataType = ftSmallint
        Precision = -1
      end    
      item
        Name = 'ID_DONO_CADASTRO'
        DataType = ftInteger
        Precision = -1
      end    
      item
        Name = 'NOME_MES'
        DataType = ftFixedChar
        Precision = -1
        Size = 9
      end>
    Database = SQLConnector
    Transaction = SQLTransaction
    SQL.Strings = (
      'select'
      '      cast(coalesce(sum(total_despesa),0) as decimal(15,2)) as total_despesa,'
      '      cast(coalesce(sum(total_recebimento),0) as decimal(15,2)) as total_recebimento,'
      '      cast(coalesce(sum(total_recebimento),0) - coalesce(sum(total_despesa),0) as decimal(15,2)) as total_saldo,'
      '      mes, ano, id_dono_cadastro,'
      '      (case'
      '           when mes = 1 then ''Janeiro'''
      '           when mes = 2 then ''Fevereiro'''
      '           when mes = 3 then ''Março'''
      '           when mes = 4 then ''Abril'''
      '           when mes = 5 then ''Maio'''
      '           when mes = 6 then ''Junho'''
      '           when mes = 7 then ''Julho'''
      '           when mes = 8 then ''Agosto'''
      '           when mes = 9 then ''Setembro'''
      '           when mes = 10 then ''Outubro'''
      '           when mes = 11 then ''Novembro'''
      '           when mes = 12 then ''Dezembro'''
      '       end) as nome_mes'
      'from'
      '    (select'
      '           cast(sum(total) as decimal(15,2)) as total_despesa,'
      '           cast(0 as decimal(15,2)) as total_recebimento,'
      '           extract(month from data) as mes,'
      '           extract(year from data) as ano,'
      '           id_dono_cadastro'
      '    from despesa'
      '    where paga = true'
      '    group by extract(month from data),'
      '             extract(year from data),'
      '             id_dono_cadastro'
      'union all'
      '    select'
      '          cast(0 as decimal(15,2)) as total_despesa,'
      '          cast(sum(valor_total) as decimal(15,2)) as total_recebimento,'
      '          extract(month from data) as mes,'
      '          extract(year from data) as ano,'
      '          id_dono_cadastro'
      '    from recebimento'
      '    group by extract(month from data),'
      '             extract(year from data),'
      '             id_dono_cadastro'
      ') s1'
      'group by mes, ano, id_dono_cadastro'
      'having ano = 2024 and id_dono_cadastro = 1'
      'order by mes asc'
    )
    Params = <>
    Macros = <>
    Left = 112
    Top = 80
  end
